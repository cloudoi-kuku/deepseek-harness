# Source-built Envon web image: `dsh --profile web` from this repository so
# workspace-source-git exists, plus the CoreNet overlay (HMAC launch,
# workspace-github clone, create({ path }) pin, /corenet/publish|database).
# Does not mount principal-hmac: operator GENERATE_TOKEN has no launch cookie
# and would otherwise empty listVisible.
#
# Build from repository root (linux/amd64 for Azure Container Apps):
#   az acr build -r acrenvonaiprdeus2 -t hosted-generate-poc:web9 \
#     -f examples/hosted-generate/azure/Dockerfile.web \
#     --build-arg DSH_CLIENT_COMMIT_HASH=$(git rev-parse HEAD) .

FROM node:22-bookworm-slim AS build
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /src
COPY . .
# python/sdk-runtime is dockerignored; drop it from the workspace so pnpm
# install does not fail on a missing member. Keep overrides, patches, allowBuilds.
# `pnpm deploy --prod` omits plugin peer packages the CLI imports at boot, so
# the runtime copies this built workspace instead.
RUN sed -i '/^- website$/d; /^- python\/sdk-runtime$/d' pnpm-workspace.yaml
ENV PNPM_PACKAGE_IMPORT_METHOD=copy
ARG DSH_CLIENT_COMMIT_HASH
ENV DSH_CLIENT_COMMIT_HASH=$DSH_CLIENT_COMMIT_HASH
RUN test -n "$DSH_CLIENT_COMMIT_HASH"
RUN pnpm install --frozen-lockfile
RUN pnpm run build
RUN chmod +x /src/apps/cli/lib/bin.js \
  && node /src/apps/cli/lib/bin.js --version

FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /src /src
RUN ln -s /src/apps/cli/lib/bin.js /usr/local/bin/dsh \
  && chmod +x /src/apps/cli/lib/bin.js \
  && node /usr/local/bin/dsh --version
WORKDIR /app
COPY examples/hosted-generate/azure/web-proxy.mjs \
     examples/hosted-generate/azure/workspace-github.mjs \
     examples/hosted-generate/azure/corenet-bridge.mjs \
     examples/hosted-generate/azure/llm-bridge.mjs \
     examples/hosted-generate/azure/grok.patch.yml \
     examples/hosted-generate/azure/generate-server.mjs \
     examples/hosted-generate/azure/generate.patch.yml \
     examples/hosted-generate/azure/launch-token.mjs \
     examples/hosted-generate/azure/generate.html \
     examples/hosted-generate/azure/entrypoint.sh \
     ./
RUN chmod +x entrypoint.sh \
  && mkdir -p /workspace /home/node/.dsh \
  && chown -R node:node /app /workspace /home/node /src
USER node
ENV NODE_ENV=production \
    HOME=/home/node \
    DSH_HOME=/home/node/.dsh \
    PORT=8080 \
    DSH_PORT=3080 \
    GENERATE_PORT=3081 \
    LLM_BRIDGE_PORT=4000
WORKDIR /workspace
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
