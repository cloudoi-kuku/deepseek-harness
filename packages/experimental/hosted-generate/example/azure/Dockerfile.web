FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g @deepseek-ai/dsh@0.1.1-rc.2
WORKDIR /app
COPY web-proxy.mjs llm-bridge.mjs grok.patch.yml generate-server.mjs generate.patch.yml launch-token.mjs generate.html entrypoint.sh ./
RUN chmod +x entrypoint.sh \
  && mkdir -p /workspace /home/node/.dsh \
  && chown -R node:node /app /workspace /home/node
USER node
ENV NODE_ENV=production \
    HOME=/home/node \
    DSH_HOME=/home/node/.dsh \
    PORT=8080 \
    DSH_PORT=3080 \
    GENERATE_PORT=3081 \
    LLM_BRIDGE_PORT=4000
WORKDIR /workspace
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
